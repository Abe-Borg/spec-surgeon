<?xml version="1.0" encoding="UTF-8"?>
<!-- Spec Surgeon: a local definition of the DCMI terms the OPC core-properties schema references (namespace
     http://purl.org/dc/terms/): dcterms:created and dcterms:modified (refinements of dc:date) and the W3CDTF encoding
     scheme Word writes on them (xsi:type="dcterms:W3CDTF") — to the shape of DCMI's 2003-04-02 dcterms.xsd, so V5a can
     validate docProps/core.xml without the network. Not a copy of DCMI's file. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:dc="http://purl.org/dc/elements/1.1/"
           xmlns="http://purl.org/dc/terms/" targetNamespace="http://purl.org/dc/terms/"
           elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:import namespace="http://purl.org/dc/elements/1.1/" schemaLocation="dc.xsd"/>
  <xs:import namespace="http://www.w3.org/XML/1998/namespace" schemaLocation="../ISO-IEC29500-4_2016/xml.xsd"/>
  <xs:element name="created" substitutionGroup="dc:date"/>
  <xs:element name="modified" substitutionGroup="dc:date"/>
  <xs:element name="issued" substitutionGroup="dc:date"/>
  <xs:element name="available" substitutionGroup="dc:date"/>
  <xs:element name="valid" substitutionGroup="dc:date"/>
  <xs:complexType name="W3CDTF">
    <xs:simpleContent>
      <xs:restriction base="dc:SimpleLiteral">
        <xs:simpleType>
          <xs:union memberTypes="xs:gYear xs:gYearMonth xs:date xs:dateTime"/>
        </xs:simpleType>
        <xs:attribute ref="xml:lang" use="prohibited"/>
      </xs:restriction>
    </xs:simpleContent>
  </xs:complexType>
</xs:schema>
