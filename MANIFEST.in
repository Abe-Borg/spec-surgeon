include LICENSE CLAUDE.md requirements.txt
recursive-include docs *.md *.png
recursive-include examples *.json *.docx *.md *.png
recursive-include tests *.py *.json
recursive-include packaging/windows *.py *.spec *.iss *.ps1 *.ico *.manifest
recursive-include src/spec_surgeon/web/icons *.svg *.png
recursive-include src/spec_surgeon/web/static *
recursive-include frontend *.ts *.tsx *.json *.css *.html *.mjs *.md
prune frontend/node_modules
recursive-include src/spec_surgeon/examples/specs *.json
include packaging/installed_wheel_smoke.py
include packaging/check_wheel_install.py
